// Replace only the primary text call in native menu-item drawing.
// ESI is the item; ECX is its active font. The native checkbox remains text
// generated by 0x48d870. Width is measured with that same font, not wcslen.
static int __fastcall selector_draw(void* font,void* item,const wchar_t* text,
                                    float x,float y,int limit,void* extra) {
  typedef int(__thiscall *Draw)(void*,const wchar_t*,float,float,int,void*);
  Draw draw=at<Draw>(0x47be20);
  if(fld(item,0)!=0x3001) return draw(font,text,x,y,limit,extra);
  typedef float(__thiscall *Measure)(void*,const wchar_t*);
  typedef const wchar_t*(__thiscall *Dict)(void*,int);
  Measure measure=at<Measure>(0x47b110);
  void* style=reinterpret_cast<void*>(fld(item,0xb0));
  const bool suffix=fld(style,0x850)==1;
  Mode list[9];int n=modes(list);
  float widest=0;
  for(int i=0;i<n;++i) {
    const wchar_t* name=at<Dict>(0x47c3e0)(at<void*>(0xde7018),list[i].id-0x2710);
    for(int checked=0;checked<2;++checked) {
      const wchar_t* box=reinterpret_cast<const wchar_t*>(fld(style,checked?0x92c:0x930));
      wchar_t candidate[128];
      if(suffix) swprintf_s(candidate,L"<< %ls %ls",name,box);
      else swprintf_s(candidate,L"%ls << %ls",box,name);
      float w=measure(font,candidate);if(w>widest) widest=w;
    }
  }
  float gap=measure(font,L" "), arrow=measure(font,L">>");
  float total=widest+gap+arrow;
  float factor=(limit>0 && total>limit)?limit/total:1.0f;
  // Use the same scale for every choice, including short fullscreen labels.
  float& scale=*reinterpret_cast<float*>(static_cast<char*>(font)+0xc);
  float saved_scale=scale;int saved_align=fld(font,4);
  float left=x;
  if(saved_align==1) left-=total*factor;
  else if(saved_align==2) left-=total*factor*0.5f;
  scale*=factor;fld(font,4)=0;
  int result=0;
  float right=left+(widest+gap)*factor;
  if(suffix && saved_align==1) {
    // Native RTL rows end with the checkbox at x. Keep that anchor and put
    // both arrows inside it; do not left-align the combined label and box.
    const wchar_t* box=reinterpret_cast<const wchar_t*>(fld(style,
                                        fld(item,0x434)?0x92c:0x930));
    float box_slot=measure(font,reinterpret_cast<const wchar_t*>(fld(style,0x92c)));
    float empty_width=measure(font,reinterpret_cast<const wchar_t*>(fld(style,0x930)));
    if(empty_width>box_slot) box_slot=empty_width;
    right=x-box_slot-gap*factor-arrow*factor;
    draw(font,L"<<",left,y,999999,extra);
    draw(font,L">>",right,y,999999,extra);
    const wchar_t* name=reinterpret_cast<const wchar_t*>(static_cast<char*>(item)+0x30);
    if(wcsncmp(name,L"<< ",3)==0) name+=3;
    fld(font,4)=1;
    result=draw(font,name,right-gap*factor,y,999999,extra);
    draw(font,box,x,y,999999,extra);
  } else {
    result=draw(font,text,left,y,999999,extra);
    draw(font,L">>",right,y,999999,extra);
  }
  scale=saved_scale;fld(font,4)=saved_align;
  return result;
}
extern "C" __declspec(naked) void selector_gate() {
  __asm {
    mov edx,esi
    jmp selector_draw
  }
}
